{
  // The other two projects cover src and vite.config.ts only, and tsx strips
  // types without checking them - so without this a type error in a test
  // survives and can leave an assertion silently inert. Standalone rather than
  // a project reference, which would need the noEmit app project to emit.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": ["src", "tests", "tests-e2e"]
}
