// The transform config tsx uses at test time (TSX_TSCONFIG_PATH in
// package.json), NOT the type check - that is tsconfig.test.json at the root.
{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  // `src` is here because tsx applies these options only to the files a
  // tsconfig matches, and everything else falls back to esbuild's defaults -
  // which compile JSX to the classic `React.createElement`. A test that
  // *renders* a component out of src (rather than only importing it) crashes
  // on an undefined `React` without this.
  "include": ["**/*.ts", "**/*.tsx", "../src/**/*.ts", "../src/**/*.tsx"]
}
