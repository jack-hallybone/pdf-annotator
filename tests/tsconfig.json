// The transform config tsx uses at test time (TSX_TSCONFIG_PATH in package.json), NOT the type check - that is tsconfig.test.json at the root.
{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  // `src` is here because tsx applies these options only to files a tsconfig matches; the rest get esbuild's classic `React.createElement` JSX, and a test rendering a src component crashes on an undefined `React`.
  "include": ["**/*.ts", "**/*.tsx", "../src/**/*.ts", "../src/**/*.tsx"]
}
