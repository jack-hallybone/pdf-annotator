# Build output
/dist
# Written by every build (scripts/prepare-renderer-assets.mjs), which ships it with the app
/THIRD-PARTY-NOTICES.md
/.generated
/.vite
/coverage
/playwright-report
/test-results
*.tsbuildinfo
# Dependencies
node_modules
# Secrets — never commit these
.env
.env.*
.npmrc
# ...except the root one, which carries `ignore-scripts=true` and no secret - a setting not in the checkout is one CI and a fresh clone never see.
!/.npmrc
*.pem
*.key
*.p12
*.pfx
# OS and editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.claude/
# Project-specific
.agents
*.local
npm-debug.log*
# PDFs are user content and never committed — except the scrubbed test fixtures.
*.pdf
!tests/fixtures/test-*.pdf
