# Nothing a dependency ships runs at install time. `npm ci` otherwise runs a
# package's preinstall/install/postinstall by default, on every package in the
# tree, with this checkout beside it: arbitrary code from ~1,100 transitive
# packages, before a single test does. A flag on the one install somebody
# remembered is not the same thing as a setting on every install anyone runs.
#
# MEASURED (npm 10.9.7): this also stops npm running THIS repository's own `pre`
# and `post` scripts, so package.json spells its build, dev and preview chains
# out with `&&` instead of relying on `prebuild`/`postbuild` being found.
ignore-scripts=true
