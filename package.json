{
  "name": "pdf-annotator",
  "version": "0.1.0",
  "productName": "PDF Annotator",
  "productShortName": "Annotate",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Client-side PDF viewer and annotator. No sign-up, no uploads, works offline.",
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "dev": "node scripts/prepare-renderer-assets.mjs && vite",
    "preview": "node scripts/prepare-renderer-assets.mjs && vite preview",
    "preview:docker": "node scripts/prepare-renderer-assets.mjs && vite preview --host 0.0.0.0",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=moderate",
    "test": "npm run test:unit && npm run test:dom && npm run test:build",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:dom": "TSX_TSCONFIG_PATH=./tests/tsconfig.json node --import tsx --import ./tests/dom-setup.ts --test tests/*.dom.test.tsx",
    "test:build": "node --test tests/build/*.test.mjs",
    "test:browser": "node tests/journey.test.mjs && node tests/worker.test.mjs",
    "test:e2e": "playwright test",
    "test:browser:setup": "playwright install --with-deps chromium",
    "build": "node scripts/clean-renderer-output.mjs && node scripts/prepare-renderer-assets.mjs && tsc -b && vite build && node scripts/strip-dangling-source-maps.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test && npm run test:browser && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workbox-precaching": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pdf-lib/upng": "1.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "global-jsdom": "30.0.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1"
  }
}
